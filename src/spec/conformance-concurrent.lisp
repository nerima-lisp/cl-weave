(in-package #:cl-weave/spec)

(defstruct (history-operation (:copier nil))
  id thread action params output invoked returned)

(defun linearization-search (spec history budget)
  (unless (typep budget '(integer 1 *))
    (signal-spec-error 'spec-configuration-error "Linearization budget must be a positive integer."))
  (let* ((ordered (stable-sort (copy-list history)
                               (lambda (a b)
                                 (or (< (history-operation-invoked a) (history-operation-invoked b))
                                     (and (= (history-operation-invoked a) (history-operation-invoked b))
                                          (< (history-operation-id a) (history-operation-id b)))))))
         (count 0) (longest nil) (exceeded nil) (states (make-state-table)))
    (labels ((visit (state remaining prefix)
               (when (>= count budget)
                 (setf exceeded t)
                 (return-from visit nil))
               (incf count)
               (setf (state-table-ref states state) t)
               (when (> (length prefix) (length longest))
                 (setf longest (reverse prefix)))
               (when (null remaining) (return-from visit t))
               (dolist (operation remaining)
                 (unless (some (lambda (other)
                                 (< (history-operation-returned other)
                                    (history-operation-invoked operation)))
                               (remove operation remaining :count 1 :test #'eq))
                   (dolist (transition (spec-successors spec state))
                     (when (and (eq (history-operation-action operation)
                                    (spec-transition-action transition))
                                (equal (history-operation-params operation)
                                       (spec-transition-params transition))
                                (let* ((action (spec-find-action spec (history-operation-action operation)))
                                       (output (spec-action-output action)))
                                  (or (null output)
                                      (equal (history-operation-output operation)
                                             (apply output state (spec-transition-to transition)
                                                    (history-operation-params operation))))))
                       (when (visit (spec-transition-to transition)
                                    (remove operation remaining :count 1 :test #'eq)
                                    (cons operation prefix))
                         (return-from visit t))
                       (when exceeded (return-from visit nil))))))
               nil))
      (dolist (initial (spec-initial-states spec))
        (when (visit initial ordered nil)
          (return-from linearization-search (values t longest nil states)))
        (when exceeded (return)))
      (values nil longest exceeded states))))

(defun linearizable-history-p (spec history &key (budget *default-linearization-budget*))
  (multiple-value-bind (linearizable prefix exceeded)
      (linearization-search spec history budget)
    (values linearizable prefix exceeded)))

(defun concurrent-operation-sequence (spec rng count)
  (let* ((initials (spec-initial-states spec))
         (state (nth (floor (* (length initials)
                               (cl-weave::property-random-below rng (expt 2 30)))
                            (expt 2 30)) initials))
         (calls nil))
    (dotimes (index count (nreverse calls))
      (let ((transitions (spec-successors spec state)))
        (unless transitions
          (signal-spec-error 'spec-configuration-error "Concurrent operations require enabled actions."))
        (let ((transition (nth (floor (* (length transitions)
                                         (cl-weave::property-random-below rng (expt 2 30)))
                                      (expt 2 30)) transitions)))
          (push (cons (spec-transition-action transition) (spec-transition-params transition)) calls)
          (setf state (spec-transition-to transition)))))))

#+sb-thread
(defun run-concurrent-history (sut operations calls threads operations-per-thread)
  (let ((gate (sb-thread:make-semaphore :count 0))
        (ready (sb-thread:make-semaphore :count 0))
        (lock (sb-thread:make-mutex :name "spec history"))
        (clock 0) (history nil) (failure nil) (workers nil))
    (labels ((stamp () (sb-thread:with-mutex (lock) (incf clock)))
             (worker (thread)
               (handler-case
                   (progn
                     (sb-thread:signal-semaphore ready)
                     (sb-thread:wait-on-semaphore gate)
                     (dotimes (index operations-per-thread)
                       (let* ((id (+ (* thread operations-per-thread) index))
                              (call (nth id calls))
                              (invoked (stamp))
                              (output (apply (cdr (assoc (car call) operations)) sut (cdr call)))
                              (returned (stamp))
                              (entry (make-history-operation :id id :thread thread :action (car call)
                                                             :params (cdr call) :output output
                                                             :invoked invoked :returned returned)))
                         (sb-thread:with-mutex (lock) (push entry history)))))
                 (serious-condition (condition)
                   (sb-thread:with-mutex (lock) (unless failure (setf failure condition)))))))
      (unwind-protect
           (progn
             (dotimes (index threads)
               (let ((thread index))
                 (push (sb-thread:make-thread (lambda () (worker thread))) workers)))
             (dotimes (index threads) (sb-thread:wait-on-semaphore ready))
             (dotimes (index threads) (sb-thread:signal-semaphore gate))
             (dolist (thread workers) (sb-thread:join-thread thread))
             (setf workers nil))
        (dolist (thread workers) (sb-thread:signal-semaphore gate))
        (dolist (thread workers) (sb-thread:join-thread thread)))
      (when failure (error failure))
      (sort history #'< :key #'history-operation-invoked))))

(defun check-linearizability (spec &key reset operations (threads 2) (operations-per-thread 5)
                                     (runs (cl-weave::property-test-count))
                                     (seed (cl-weave::property-seed))
                                     (budget *default-linearization-budget*) allow-bounded)
  (cl-weave::require-platform-capability :concurrency)
  (unless (and (typep threads '(integer 1 *)) (typep operations-per-thread '(integer 1 *))
               (typep runs '(integer 1 *)) (typep budget '(integer 1 *)))
    (signal-spec-error 'spec-configuration-error "Concurrency limits must be positive integers."))
  (dolist (action (spec-actions spec))
    (unless (functionp (cdr (assoc (spec-action-name action) operations)))
      (signal-spec-error 'spec-configuration-error "Missing operation for action ~S." (spec-action-name action))))
  #+sb-thread
  (let ((rng (cl-weave::make-property-rng-from-seed seed)) (runs-done 0)
        (seen (make-state-table)) (depth-reached 0))
    (labels ((result (&key violation truncated)
               (make-spec-result :spec-name (spec-name spec) :mode :linearizability
                                 :violation violation :states-found (state-table-count seen)
                                 :depth-reached depth-reached :truncated truncated
                                 :truncation-reason (and truncated :budget)
                                 :allow-bounded allow-bounded :checked-properties nil
                                 :limits (list :budget budget)
                                 :statistics (list :runs runs-done :seed seed))))
      (dotimes (index runs)
        (let* ((calls (concurrent-operation-sequence spec rng (* threads operations-per-thread)))
               (history (run-concurrent-history (funcall reset) operations calls threads operations-per-thread)))
          (incf runs-done)
          (multiple-value-bind (linearizable prefix exceeded states)
              (linearization-search spec history budget)
            (map-state-table (lambda (state value)
                               (declare (ignore value))
                               (setf (state-table-ref seen state) t))
                             states)
            (setf depth-reached (max depth-reached (length prefix)))
            (when exceeded (return-from check-linearizability (result :truncated t)))
            (unless linearizable
              (return-from check-linearizability
                (result :violation (make-spec-violation :kind :linearizability
                                                        :detail (list :history history :longest-prefix prefix))))))))
      (result)))
  #-sb-thread
  (error "Concurrency is unavailable on this Lisp implementation."))
