(in-package #:cl-weave/spec)

(defun check-refinement (low high mapping &key (max-states *default-max-states*)
                                             (max-depth *default-max-depth*)
                                             allow-bounded (temporal :all))
  (unless (or (eq temporal :all) (null temporal)
              (handler-case (and (list-length temporal) t)
                (type-error () nil)))
    (signal-spec-error 'spec-configuration-error "Temporal properties must be :ALL or a list."))
  (unless (eq temporal :all)
    (dolist (name temporal)
      (unless (find name (spec-temporal-properties high) :key #'spec-temporal-property-name)
        (signal-spec-error 'spec-configuration-error "Unknown temporal property ~S." name))))
  (let* ((initials (spec-initial-states high))
         (properties (if (eq temporal :all)
                         (mapcar #'spec-temporal-property-name (spec-temporal-properties high))
                         temporal))
         (graph (make-state-graph :spec low))
         (edges (state-graph-edges graph)))
    (labels ((mapped (state) (make-state high (funcall mapping state)))
             (initial-check (state)
               (let ((target (mapped state)))
                 (push state (state-graph-initial-states graph))
                 (setf (state-table-ref edges state) nil)
                 (unless (member target initials :test #'equal)
                   (make-spec-violation :kind :refinement
                                        :detail (list :phase :init :low-from nil :low-to state
                                                      :mapped-from nil :mapped-to target)))))
             (step-check (transition)
               (let* ((from (spec-transition-from transition))
                      (to (spec-transition-to transition))
                      (mapped-from (mapped from))
                      (mapped-to (mapped to)))
                 (unless (or (equal mapped-from mapped-to)
                             (find mapped-to (spec-successors high mapped-from)
                                   :key #'spec-transition-to :test #'equal))
                   (return-from step-check
                     (make-spec-violation :kind :refinement
                                          :detail (list :phase :step :low-from from :low-to to
                                                        :mapped-from mapped-from :mapped-to mapped-to))))
                 (unless (nth-value 1 (state-table-ref edges to))
                   (setf (state-table-ref edges to) nil))
                 (setf (state-table-ref edges from)
                       (append (state-table-ref edges from) (list transition)))
                 nil)))
      (let ((result (explore-spec low :max-states max-states :max-depth max-depth
                                  :allow-bounded allow-bounded :temporal nil :symmetry nil
                                  :initial-check #'initial-check :step-check #'step-check)))
        (setf (spec-result-mode result) :refinement
              (spec-result-liveness-requested result) properties)
        (when (and properties (not (spec-result-truncated result))
                   (not (spec-result-violation result)))
          (let* ((lifted-properties
                   (loop for property in (spec-temporal-properties high)
                         collect (let ((predicate (spec-temporal-property-predicate property))
                                       (consequent (spec-temporal-property-consequent property)))
                                   (make-spec-temporal-property
                                    :name (spec-temporal-property-name property)
                                    :kind (spec-temporal-property-kind property)
                                    :predicate (lambda (state) (funcall predicate (mapped state)))
                                    :consequent (when consequent
                                                  (lambda (state) (funcall consequent (mapped state))))))))
                 (combined (make-spec :name (spec-name low)
                                      :constants (spec-constants low)
                                      :variables (spec-variables low)
                                      :init (spec-init low) :actions (spec-actions low)
                                      :temporal-properties lifted-properties
                                      :fairness-conditions (spec-fairness-conditions low))))
            (setf (state-graph-initial-states graph) (nreverse (state-graph-initial-states graph))
                  (state-graph-complete-p graph) t
                  (spec-result-checked-properties result)
                  (append (remove :deadlock (spec-result-checked-properties result))
                          (loop for property in (spec-temporal-properties high)
                                for name = (spec-temporal-property-name property)
                                when (member name properties) collect name)
                          (when (member :deadlock (spec-result-checked-properties result))
                            (list :deadlock)))
                  (spec-result-violation result)
                  (first (check-temporal-properties combined graph :properties properties)))))
        result))))
