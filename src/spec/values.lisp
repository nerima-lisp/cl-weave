(in-package #:cl-weave/spec)

(defun value-rank (value)
  (typecase value
    (number 0) (character 1) (string 2) (symbol 3) (cons 4)
    (bit-vector 5) (pathname 6)
    (t (signal-spec-error 'spec-value-error "Cannot order value ~S." value))))

(defun number-type-rank (number) (cond ((integerp number) 0) ((rationalp number) 1) ((complexp number) 6) ((typep number (quote short-float)) 2) ((typep number (quote single-float)) 3) ((typep number (quote double-float)) 4) (t 5)))

(defun number-value< (a b)
  (let ((ra (number-type-rank a)) (rb (number-type-rank b)))
    (cond ((/= ra rb) (< ra rb))
          ((complexp a)
           (if (eql (realpart a) (realpart b))
               (number-value< (imagpart a) (imagpart b))
               (number-value< (realpart a) (realpart b))))
          ((< a b) t)
          ((> a b) nil)
          ((eql a b) nil)
          (t (string< (write-to-string a :readably t)
                      (write-to-string b :readably t))))))

(defun symbol-value< (a b)
  (let ((pa (if (symbol-package a) (package-name (symbol-package a)) ""))
        (pb (if (symbol-package b) (package-name (symbol-package b)) "")))
    (if (string= pa pb)
        (string< (symbol-name a) (symbol-name b))
        (string< pa pb))))

(defun value< (a b)
  (let ((ra (value-rank a)) (rb (value-rank b)))
    (cond ((/= ra rb) (< ra rb))
          ((equal a b) nil)
          (t (case ra
               (0 (number-value< a b))
               (1 (char< a b))
               (2 (string< a b))
               (3 (symbol-value< a b))
               (4 (if (equal (car a) (car b))
                      (value< (cdr a) (cdr b))
                      (value< (car a) (car b))))
               (5 (loop for x across a for y across b
                        when (/= x y) do (return (< x y))
                        finally (return (< (length a) (length b)))))
               (6 (flet ((components (p)
                           (list (namestring (make-pathname :host (pathname-host p)))
                                 (pathname-device p) (pathname-directory p)
                                 (pathname-name p) (pathname-type p)
                                 (pathname-version p))))
                    (value< (components a) (components b)))))))))

(defun make-spec-set (elements)
  (cons '%set (sort (remove-duplicates (copy-list elements) :test #'equal)
                    #'value<)))

(defun spec-set (&rest elements) (make-spec-set elements))
(defun spec-set-p (value) (and (consp value) (eq (car value) '%set)))
(defun spec-set-elements (set) (copy-list (cdr set)))
(defun spec-set-size (set) (length (cdr set)))
(defun spec-set-member-p (element set) (not (null (member element (cdr set) :test #'equal))))
(defun spec-set-union (a b) (make-spec-set (append (cdr a) (cdr b))))
(defun spec-set-intersection (a b)
  (make-spec-set (remove-if-not (lambda (x) (spec-set-member-p x b)) (cdr a))))
(defun spec-set-difference (a b)
  (make-spec-set (remove-if (lambda (x) (spec-set-member-p x b)) (cdr a))))
(defun spec-subset-p (a b) (every (lambda (x) (spec-set-member-p x b)) (cdr a)))

(defun spec-powerset (set)
  (when (> (spec-set-size set) 20)
    (signal-spec-error 'spec-value-error "Powerset exceeds 20 elements."))
  (make-spec-set
   (mapcar #'make-spec-set
           (reduce (lambda (subsets element)
                     (append subsets (mapcar (lambda (subset) (cons element subset)) subsets)))
                   (cdr set) :initial-value (list nil)))))

(defun spec-set-filter (predicate set)
  (make-spec-set (remove-if-not predicate (cdr set))))
(defun spec-set-map (function set)
  (make-spec-set (mapcar function (cdr set))))

(defmacro spec-set-of (expression for variable in set &optional when condition) (unless (and (eq for :for) (symbolp variable) (eq in :in) (or (null when) (eq when :when))) (signal-spec-error (quote spec-value-error) "Malformed set comprehension.")) `(make-spec-set (loop for ,variable in (spec-set-elements ,set) ,@(when when `(when ,condition)) collect ,expression)))

(defun make-spec-function (pairs)
  (let ((copy (mapcar (lambda (pair) (cons (car pair) (cdr pair))) pairs)))
    (when (/= (length copy) (length (remove-duplicates copy :key #'car :test #'equal)))
      (signal-spec-error 'spec-value-error "Duplicate function key."))
    (cons '%function (sort copy #'value< :key #'car))))

(defun spec-function-over (domain function)
  (make-spec-function (mapcar (lambda (x) (cons x (funcall function x))) (cdr domain))))
(defun spec-function-p (value) (and (consp value) (eq (car value) '%function)))
(defun spec-function-pairs (function)
  (mapcar (lambda (pair) (cons (car pair) (cdr pair))) (cdr function)))
(defun spec-function-domain (function) (make-spec-set (mapcar #'car (cdr function))))
(defun spec-function-apply (function argument)
  (let ((pair (assoc argument (cdr function) :test #'equal)))
    (unless pair (signal-spec-error 'spec-value-error "Function has no key ~S." argument))
    (cdr pair)))
(defun spec-function-except (function argument value)
  (unless (assoc argument (cdr function) :test #'equal)
    (signal-spec-error 'spec-value-error "Function has no key ~S." argument))
  (make-spec-function (mapcar (lambda (pair)
                                (if (equal (car pair) argument)
                                    (cons (car pair) value) pair))
                              (cdr function))))

(defun make-spec-record (&rest plist)
  (unless (evenp (length plist))
    (signal-spec-error 'spec-value-error "Record requires field/value pairs."))
  (let ((pairs (loop for (field value) on plist by #'cddr collect (cons field value))))
    (unless (and (every #'symbolp (mapcar #'car pairs))
                 (= (length pairs) (length (remove-duplicates pairs :key #'car :test #'eq))))
      (signal-spec-error 'spec-value-error "Record fields must be distinct symbols."))
    (cons '%record (loop for (field . value) in (sort pairs #'value< :key #'car)
                         append (list field value)))))
(defun spec-record-p (value) (and (consp value) (eq (car value) '%record)))
(defun spec-record-fields (record) (loop for tail on (cdr record) by (function cddr) collect (car tail)))
(defun spec-record-ref (record field)
  (loop for (key value) on (cdr record) by #'cddr
        when (eq key field) do (return value)
        finally (signal-spec-error 'spec-value-error "Record has no field ~S." field)))
(defun spec-record-except (record field value)
  (unless (member field (spec-record-fields record) :test #'eq)
    (signal-spec-error 'spec-value-error "Record has no field ~S." field))
  (apply #'make-spec-record
         (loop for (key old) on (cdr record) by #'cddr
               append (list key (if (eq key field) value old)))))

(defun make-spec-sequence (elements) (cons '%sequence (copy-list elements)))
(defun spec-sequence (&rest elements) (make-spec-sequence elements))
(defun spec-sequence-p (value) (and (consp value) (eq (car value) '%sequence)))
(defun spec-sequence-elements (sequence) (copy-list (cdr sequence)))
(defun spec-sequence-concat (a b) (make-spec-sequence (append (cdr a) (cdr b))))
(defun spec-sequence-length (sequence) (length (cdr sequence)))
(defun spec-sequence-ref (sequence index)
  (unless (and (integerp index) (<= 0 index) (< index (spec-sequence-length sequence)))
    (signal-spec-error 'spec-value-error "Sequence index ~S is out of range." index))
  (nth index (cdr sequence)))

(defun map-value-atoms (function value)
  (labels ((walk (x)
             (cond ((spec-set-p x)
                    (make-spec-set (mapcar (function walk) (cdr x))))
                   ((spec-function-p x)
                    (make-spec-function
                     (mapcar (lambda (pair)
                               (cons (walk (car pair)) (walk (cdr pair))))
                             (cdr x))))
                   ((spec-record-p x)
                    (apply (function make-spec-record)
                           (loop for (field val) on (cdr x) by (function cddr)
                                 append (list field (walk val)))))
                   ((spec-sequence-p x)
                    (make-spec-sequence (mapcar (function walk) (cdr x))))
                   ((consp x)
                    (cons (walk (car x))
                          (if (null (cdr x)) nil (walk (cdr x)))))
                   (t (funcall function x)))))
    (walk value)))
