# nerima-lisp standard .gitignore
# Copy to <repo>/.gitignore and append repository-specific entries below the
# marked section. Everything above the marker must stay identical across repos
# so that "is this artifact ignored?" has the same answer everywhere.

# --- Common Lisp build output ---
*.fasl
*.fas
*.lib
*.dfsl
*.ufsl
*.fsl

# --- Nix ---
/result
/result-*
/.direnv/

# --- Test and coverage output ---
/coverage/
/coverage-report/
/*-coverage-report/
*.coverage
coverage.dat
/__snapshots__/
/*-snapshots/

# --- Local caches and scratch space ---
/.cache/
/.deps/
/tmp/
/.worktrees/
/.paredit.cleanup/

# --- Credentials ---
# Not because anyone plans to put a key here, but because the cost of the one
# time it happens by accident is a rotation across the whole org. See
# SUPPLY_CHAIN.md for what to do if one is committed anyway.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
/secrets/

# --- Editor and OS noise ---
.DS_Store
*~
\#*\#
.\#*

# --- Repository-specific entries below this line ---

# Fasl extensions for the non-SBCL implementations the platform layer targets.
*.abcl
*.lx64fsl
*.dx64fsl

# The coverage gate writes one report tree per filter, and the prefixed form is
# not matched by the standard `/*-coverage-report/` suffix rule above.
/coverage-report-*/
/coverage-filter-*/

# Reporter artifacts the CLI writes into the working tree when it is run
# outside the Nix sandbox. `nix flake check` regenerates all of them.
cl-weave-results.json
cl-weave-events.jsonl
cl-weave-cli-results.json
cl-weave-metadata.json
cl-weave-plan.json
cl-weave-watch-once.json
cl-weave-tap.txt
cl-weave-junit.xml
cl-weave-doctor.json

# MkDocs local build output (docs/mkdocs.yml sets site_dir: ../site).
/site/

# Claude Code tooling state (worktrees, session data).
/.claude/
